# PDF Insight - Environment Variables Template
# COPY this file to .env.local for local development.
# NEVER commit .env or .env.local to Git!

# OpenRouter API Key (Used strictly on the backend/proxy side, NEVER exposed to client SPA)
OPENROUTER_API_KEY=

# Backend API Proxy URL (Defaults to local proxy in dev, or deployed Edge Worker in production)
# Example: https://pdf-insight-proxy.your-subdomain.workers.dev/api/analyze
VITE_API_URL=http://localhost:3001/api/analyze

# Optional: Preferred LLM model for OpenRouter
# Defaults to anthropic/claude-3.5-sonnet or meta-llama/llama-3.3-70b-instruct
VITE_AI_MODEL=meta-llama/llama-3.3-70b-instruct

# Demo deployment base path for GitHub Pages
# Set to '/<repo-name>/' for production builds on GitHub Pages
VITE_BASE_PATH=/
