# PDF Insight - Environment Variables Template
# COPY this file to .env.local for local development.
# NEVER commit .env or .env.local to Git!

# --- Server side only (read by the Vite dev proxy / Cloudflare Worker) ---------
# OpenRouter API Key. No VITE_ prefix on purpose: it is NEVER bundled into the browser code.
# In production it is stored as a Worker secret: npx wrangler secret put OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Model(s) used by the proxy – first is primary, the rest are fallbacks (comma-separated, max 3)
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Per-attempt timeout of the AI call in ms (free-tier models can take 30–90 s)
OPENROUTER_TIMEOUT_MS=90000

# --- Client side (public, bundled into the SPA) ---------------------------------
# Backend proxy URL. Leave empty in local dev – the Vite dev server serves /api/analyze itself.
# Production (GitHub Actions repository variable): https://pdf-insight-proxy.<subdomain>.workers.dev/api/analyze
VITE_API_URL=

# UI development without an API key: returns a static mock result
VITE_USE_MOCK=false

# Base path for GitHub Pages builds (CI sets '/<repo-name>/'); defaults to './'
VITE_BASE_PATH=
